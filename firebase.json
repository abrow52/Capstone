{
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
     
      {
        "source": "/login",
        "destination": "/login.html"
      },
      {
        "source": "/home",
        "destination": "/index.html"
      },
      {
        "source": "/hub",
        "destination": "/schedulingHub.html"
      },
      {

        "source": "/requests",
        "destination": "/requests.html"
      },
      {
        "source": "/dash",
        "destination": "/employeeDashboard.html"
      }
    ]
  }
}
